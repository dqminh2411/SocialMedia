# Application (Docker Compose port mappings)
BE_PORT=8080
FE_PORT=3000

# API
API_PREFIX=/api/v1

# Database
DB_URL=<your-database-url>
DB_NAME=socialmedia
DB_USER=<your-database-username>
DB_PASS=<your-database-password>
DB_ROOT_PASS=<your-database-root-password>

# Host port mapped to MySQL 3306
DB_PORT=3307


# JWT (optional overrides)
# Used by Spring properties:
# - `app.jwt.base64-secret`
# - `app.jwt.access-token-validity-in-seconds`
# - `app.jwt.refresh-token-validity-in-seconds`
APP_JWT_BASE64_SECRET=<your-jwt-secret>
APP_JWT_ACCESS_TOKEN_VALIDITY_IN_SECONDS=900
APP_JWT_REFRESH_TOKEN_VALIDITY_IN_SECONDS=2592000

# OAuth2 Google (optional)
# Spring env var equivalents are long; keep these as placeholders if you wire them in.
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>
GOOGLE_SCOPE=profile,email
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# SMTP (optional)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=<your-email>
SPRING_MAIL_PASSWORD=<your-spring-mail-password> 

# Cloudinary 
CLOUDINARY_URL=<your-cloudinary-url>

# Redis (Docker Compose + Spring Boot)
# Host port mapped to Redis 6379
REDIS_PORT=6379

SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=<your-redis-password>
SPRING_DATA_REDIS_TIMEOUT=2s